{
  "name": "hanzi-chai",
  "version": "1.0.0-beta.1",
  "description": "汉字自动拆分、编码算法库与方案命令行工具",
  "type": "module",
  "bin": {
    "chai": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": "./dist/index.js",
      "default": "./dist/main.js"
    },
    "./evaluation": "./dist/evaluation.js",
    "./examples/*.yaml": "./dist/examples/*.yaml"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/copy-assets.ts",
    "cli": "bun src/cli.ts",
    "test:scheme": "bun test ./spec/scheme.spec.ts ./spec/cli.spec.ts",
    "test": "bun test ./spec/*.spec.ts",
    "test:all": "bun test ./spec",
    "fetch:data": "bun scripts/fetch-data.ts",
    "prepack": "npm run build",
    "check:package": "bun scripts/check-package.ts",
    "chai": "bun src/cli.ts",
    "fetch": "bun scripts/fetch.ts",
    "check:code-tables": "bun scripts/check-code-tables.ts",
    "audit:glyph-ids": "bun scripts/audit-glyph-ids.ts",
    "migrate:glyph-ids": "bun scripts/migrate-glyph-ids.ts",
    "analyze:equivalence": "bun scripts/analyze-equivalence.ts",
    "typecheck": "tsc",
    "typecheck:web": "bun run --cwd web typecheck",
    "typecheck:api": "bun run --cwd api typecheck",
    "lint": "biome check . --error-on-warnings",
    "lint:web": "bun run --cwd web lint",
    "fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "dev:web": "bun run --cwd web dev",
    "start": "bun run dev:web",
    "dev": "bun run dev:web",
    "preview": "bun run --cwd web preview",
    "build:pkg": "bun run build",
    "build:web": "bun run build:CF",
    "start:api": "bun run build && bun run --cwd api start",
    "deploy:api": "bun run build && bun run --cwd api deploy",
    "release": "bump --tag --commit --push",
    "build:BEX": "bun run build && bun run --cwd web build:BEX",
    "build:PAGES": "bun run build && bun run --cwd web build:PAGES",
    "build:CF": "bun run build && bun run --cwd web build:CF",
    "build:CLIENT": "bun run build && bun run --cwd web build:CLIENT"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "js-yaml": "^4.1.1",
    "libchai": "0.4.0",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "bun-types": "latest",
    "typescript": "^6.0.3",
    "@biomejs/biome": "2.5.0",
    "@jsdevtools/version-bump-prompt": "^6.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^25.9.0",
    "fs-extra": "^11.3.5",
    "mupdf": "1.28.1",
    "dotenv": "^17.4.2"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "author": {
    "name": "tansongchen",
    "email": "i@tansongchen.com",
    "url": "https://tansongchen.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzi-chai/hanzi-chai"
  },
  "license": "GPL-3.0-only",
  "workspaces": [
    "web",
    "api"
  ]
}
